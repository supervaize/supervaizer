services:
  {{SERVICE_NAME}}:
    build:
      context: ..
      dockerfile: .deployment/Dockerfile
    ports:
      - "127.0.0.1:{{PORT}}:{{PORT}}"
    environment:
{{ENV_VARS}}
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:{{PORT}}/.well-known/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    restart: unless-stopped
    networks:
      - supervaizer-network

networks:
  supervaizer-network:
    driver: bridge
