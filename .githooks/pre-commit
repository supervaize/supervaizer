#!/bin/sh
# Installed by `just install-hooks`, which points core.hooksPath at this directory.

# Run the pre-commit stage of .pre-commit-config.yaml on the staged files.
uv run python -m pre_commit run --hook-stage pre-commit || exit $?

# A plain `git commit` on gitbutler/workspace breaks GitButler mode, so refuse it.
# GitButler reads the GITBUTLER_ERROR marker and ignores this failure for its own commits.
if [ "$(git symbolic-ref --short HEAD 2>/dev/null)" = "gitbutler/workspace" ]; then
    echo "GITBUTLER_ERROR: Cannot commit directly to gitbutler/workspace."
    echo "Run 'but commit', or check out another branch to use plain git."
    exit 1
fi
